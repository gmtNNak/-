#!/usr/bin/env python3
"""
変形する空間そのものを可視化する生成映像

数値状態
    ↓
2次元座標を6次元空間へ埋め込む
    ↓
各地点の局所的な距離関係を計算
    ↓
空間の伸縮・歪み・曲がりを画像化
    ↓
画像の特徴を数値状態へ戻す
    ↓
次の空間を生成

物体・粒子・光源・カメラ・3D密度場は使用しない。

出力:
    generative_space.mp4

形式:
    H.264
    yuv420p
    480x270
    24fps
"""

import math
import subprocess
import sys
from pathlib import Path

import numpy as np
from PIL import Image


# ============================================================
# 設定
# ============================================================

WIDTH = 480
HEIGHT = 270

FRAMES = 240
FPS = 24

OUTPUT = Path("generative_space.mp4")

# ffmpegの一時入力
# /tmp に置くので作業フォルダが散らからない
TEMP_DIR = Path("/tmp/generative_space_frames")

EPS = 1e-8


# ============================================================
# 座標
# ============================================================

x = np.linspace(
    -1.0,
    1.0,
    WIDTH,
    dtype=np.float32
)

y = np.linspace(
    -1.0,
    1.0,
    HEIGHT,
    dtype=np.float32
)

U, V = np.meshgrid(x, y)


# ============================================================
# 補助関数
# ============================================================

def normalize(a):
    """
    配列を0〜1へ正規化する。

    極端な外れ値によって画面全体が
    真っ黒・真っ白になるのを防ぐ。
    """

    lo = np.percentile(a, 2)
    hi = np.percentile(a, 98)

    if hi - lo < EPS:
        return np.zeros_like(a)

    a = (a - lo) / (hi - lo)

    return np.clip(a, 0.0, 1.0)


def derivative_x(a):
    """
    x方向の微分
    """

    return np.gradient(
        a,
        x,
        axis=1
    )


def derivative_y(a):
    """
    y方向の微分
    """

    return np.gradient(
        a,
        y,
        axis=0
    )


# ============================================================
# 高次元空間を生成
# ============================================================

def make_space(state, t):
    """
    2次元の観測座標 U,V を
    6次元空間へ埋め込む。

    ここでは物体を作っていない。

    「この場所」と「隣の場所」の距離関係が
    時間とともに変化する。
    """

    a, b, c, d, e, f, g, h = state

    time = t * 0.018

    # --------------------------------------------------------
    # 第1・第2次元
    # --------------------------------------------------------

    p0 = U
    p1 = V

    # --------------------------------------------------------
    # 第3次元
    # --------------------------------------------------------

    p2 = np.sin(
        U * (2.0 + 4.0 * a)
        +
        V * (1.0 + 3.0 * b)
        +
        time * (0.5 + 2.0 * c)
    )

    # --------------------------------------------------------
    # 第4次元
    # --------------------------------------------------------

    p3 = np.cos(
        U * (1.0 + 3.0 * d)
        -
        V * (3.0 + 4.0 * e)
        +
        time * (0.7 + 2.0 * f)
    )

    # --------------------------------------------------------
    # 第5次元
    # --------------------------------------------------------

    p4 = np.sin(
        U * V * (5.0 + 8.0 * g)
        +
        (U * U - V * V)
        * (1.0 + 4.0 * h)
        +
        time
    )

    # --------------------------------------------------------
    # 第6次元
    # --------------------------------------------------------

    p5 = np.cos(
        (U + V)
        * (2.0 + 5.0 * a)
        +
        (U - V)
        * (1.0 + 4.0 * d)
        +
        p2 * p3
        * (1.0 + 3.0 * g)
    )

    return np.stack(
        [
            p0,
            p1,
            p2,
            p3,
            p4,
            p5
        ],
        axis=0
    )


# ============================================================
# 空間を解析
# ============================================================

def analyze_space(P):
    """
    高次元空間の局所的な距離関係を計算する。

    E,F,G:
        空間の局所的な計量

    metric:
        空間がどれくらい伸び縮みしているか

    anisotropy:
        x方向とy方向の性質の違い

    curvature:
        空間がどれくらい曲がっているか

    orientation:
        空間の主方向
    """

    channels = P.shape[0]

    # --------------------------------------------------------
    # 一階微分
    # --------------------------------------------------------

    Px = np.empty_like(P)
    Py = np.empty_like(P)

    for i in range(channels):

        Px[i] = derivative_x(P[i])
        Py[i] = derivative_y(P[i])

    # --------------------------------------------------------
    # 計量テンソル
    #
    # ds² =
    #     E dx²
    #   + 2F dxdy
    #   + G dy²
    # --------------------------------------------------------

    E = np.sum(
        Px * Px,
        axis=0
    )

    F = np.sum(
        Px * Py,
        axis=0
    )

    G = np.sum(
        Py * Py,
        axis=0
    )

    determinant = (
        E * G
        -
        F * F
    )

    determinant = np.maximum(
        determinant,
        EPS
    )

    metric = np.sqrt(
        determinant
    )

    # --------------------------------------------------------
    # 異方性
    # --------------------------------------------------------

    trace = E + G

    anisotropy = np.sqrt(
        np.maximum(
            (E - G) ** 2
            +
            4.0 * F * F,
            0.0
        )
    )

    anisotropy /= (
        trace
        +
        EPS
    )

    # --------------------------------------------------------
    # 曲率の近似
    # --------------------------------------------------------

    laplacian = np.empty_like(P)

    for i in range(channels):

        pxx = derivative_x(
            derivative_x(P[i])
        )

        pyy = derivative_y(
            derivative_y(P[i])
        )

        laplacian[i] = (
            pxx
            +
            pyy
        )

    curvature = np.sqrt(
        np.sum(
            laplacian * laplacian,
            axis=0
        )
    )

    # --------------------------------------------------------
    # 空間の主方向
    # --------------------------------------------------------

    orientation = 0.5 * np.arctan2(
        2.0 * F,
        E - G + EPS
    )

    return (
        metric,
        anisotropy,
        curvature,
        orientation
    )


# ============================================================
# 空間 → 画像
# ============================================================

def render_space(
    metric,
    anisotropy,
    curvature,
    orientation
):
    """
    空間の性質そのものを画像化する。

    光源を置いているわけではない。

    画像の明るさは、

        空間の伸縮
        空間の方向性
        空間の曲がり

    から直接決まる。
    """

    # --------------------------------------------------------
    # 空間の伸縮
    # --------------------------------------------------------

    metric_n = normalize(
        np.log1p(metric)
    )

    # --------------------------------------------------------
    # 曲率
    # --------------------------------------------------------

    curvature_n = normalize(
        np.log1p(curvature)
    )

    # --------------------------------------------------------
    # 空間の方向
    # --------------------------------------------------------

    directional = (
        np.cos(
            4.0 * orientation
        )
        * 0.5
        +
        0.5
    )

    # --------------------------------------------------------
    # 合成
    # --------------------------------------------------------

    image = (
        metric_n * 0.50
        +
        anisotropy
        * directional
        * 0.25
        +
        curvature_n
        * 0.25
    )

    image = normalize(
        image
    )

    # コントラスト
    image = np.power(
        image,
        0.72
    )

    return image


# ============================================================
# 画像 → 次の空間
# ============================================================

def update_state(
    state,
    metric,
    anisotropy,
    curvature,
    image
):
    """
    現在の空間から次の空間を決定する。

    つまり、

        空間
         ↓
        観測
         ↓
        数値
         ↓
        次の空間

    という循環になる。
    """

    features = np.array(
        [
            np.mean(metric),
            np.std(metric),

            np.mean(anisotropy),
            np.std(anisotropy),

            np.mean(curvature),
            np.std(curvature),

            np.mean(image),
            np.std(image),
        ],
        dtype=np.float32
    )

    # --------------------------------------------------------
    # 非線形フィードバック
    # --------------------------------------------------------

    feedback = np.tanh(
        features
        *
        np.array(
            [
                1.7,
                2.3,
                2.0,
                2.7,
                1.4,
                2.2,
                3.0,
                2.5
            ],
            dtype=np.float32
        )
    )

    # --------------------------------------------------------
    # 状態の循環
    # --------------------------------------------------------

    rotated = np.roll(
        state,
        1
    )

    new_state = (
        state * 0.965
        +
        feedback * 0.020
        +
        rotated * 0.012
    )

    # --------------------------------------------------------
    # 非線形化
    # --------------------------------------------------------

    new_state = np.tanh(
        new_state
        +
        0.035
        *
        np.sin(
            state * 7.0
            +
            np.roll(
                state,
                2
            )
        )
    )

    return new_state.astype(
        np.float32
    )


# ============================================================
# ffmpeg確認
# ============================================================

def check_ffmpeg():

    try:

        subprocess.run(
            [
                "ffmpeg",
                "-version"
            ],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=True
        )

        return True

    except (
        FileNotFoundError,
        subprocess.CalledProcessError
    ):

        return False


# ============================================================
# メイン
# ============================================================

def main():

    # --------------------------------------------------------
    # ffmpeg確認
    # --------------------------------------------------------

    if not check_ffmpeg():

        print(
            "ffmpegが見つかりません。"
        )

        print(
            "以下を実行してください:"
        )

        print()

        print(
            "sudo apt install ffmpeg"
        )

        sys.exit(1)

    # --------------------------------------------------------
    # 一時ディレクトリ
    # --------------------------------------------------------

    if TEMP_DIR.exists():

        for old_file in TEMP_DIR.glob(
            "frame_*.png"
        ):

            old_file.unlink()

    else:

        TEMP_DIR.mkdir(
            parents=True
        )

    # --------------------------------------------------------
    # 初期状態
    # --------------------------------------------------------

    state = np.array(
        [
            0.17,
            -0.31,
            0.42,
            -0.08,
            0.27,
            -0.44,
            0.19,
            0.36
        ],
        dtype=np.float32
    )

    previous = None

    print()
    print(
        "========================================"
    )
    print(
        "  GENERATIVE SPACE"
    )
    print(
        "========================================"
    )
    print()

    print(
        f"解像度 : {WIDTH} x {HEIGHT}"
    )

    print(
        f"FPS    : {FPS}"
    )

    print(
        f"Frames : {FRAMES}"
    )

    print(
        f"出力   : {OUTPUT}"
    )

    print()

    # ========================================================
    # フレーム生成
    # ========================================================

    for frame_no in range(FRAMES):

        # ----------------------------------------------------
        # 空間生成
        # ----------------------------------------------------

        P = make_space(
            state,
            frame_no
        )

        # ----------------------------------------------------
        # 空間解析
        # ----------------------------------------------------

        (
            metric,
            anisotropy,
            curvature,
            orientation
        ) = analyze_space(P)

        # ----------------------------------------------------
        # 空間を画像として観測
        # ----------------------------------------------------

        image = render_space(
            metric,
            anisotropy,
            curvature,
            orientation
        )

        # ----------------------------------------------------
        # 時間的連続性
        # ----------------------------------------------------

        if previous is not None:

            image = (
                previous * 0.88
                +
                image * 0.12
            )

        previous = image.copy()

        # ----------------------------------------------------
        # PNGとして一時保存
        # ----------------------------------------------------

        frame_path = (
            TEMP_DIR
            /
            f"frame_{frame_no:06d}.png"
        )

        frame = Image.fromarray(
            np.uint8(
                np.clip(
                    image,
                    0.0,
                    1.0
                )
                *
                255
            ),
            mode="L"
        )

        frame.save(
            frame_path,
            format="PNG"
        )

        # ----------------------------------------------------
        # 次の空間へ
        # ----------------------------------------------------

        state = update_state(
            state,
            metric,
            anisotropy,
            curvature,
            image
        )

        # ----------------------------------------------------
        # 進行表示
        # ----------------------------------------------------

        if (
            frame_no % 10 == 0
            or
            frame_no == FRAMES - 1
        ):

            progress = (
                (frame_no + 1)
                /
                FRAMES
                *
                100
            )

            print(
                f"[{progress:6.2f}%] "
                f"frame {frame_no:03d}  "
                f"state={np.mean(state):+.3f}"
            )

    # ========================================================
    # ffmpeg
    # ========================================================

    print()
    print(
        "MP4へ変換中..."
    )
    print()

    input_pattern = (
        str(TEMP_DIR)
        +
        "/frame_%06d.png"
    )

    command = [
        "ffmpeg",

        "-y",

        "-framerate",
        str(FPS),

        "-i",
        input_pattern,

        # H.264
        "-c:v",
        "libx264",

        # YouTubeなどで扱いやすい
        "pixel format"
    ]

    # 上のcommandを組み直す
    command = [
        "ffmpeg",

        "-y",

        "-framerate",
        str(FPS),

        "-i",
        input_pattern,

        "-c:v",
        "libx264",

        "-pix_fmt",
        "yuv420p",

        "-crf",
        "18",

        "-preset",
        "medium",

        "-movflags",
        "+faststart",

        str(OUTPUT)
    ]

    result = subprocess.run(
        command
    )

    if result.returncode != 0:

        print()
        print(
            "ffmpegでエラーが発生しました。"
        )

        sys.exit(1)

    # ========================================================
    # 一時ファイル削除
    # ========================================================

    print()
    print(
        "一時PNGを削除しています..."
    )

    for frame_path in TEMP_DIR.glob(
        "frame_*.png"
    ):

        frame_path.unlink()

    try:

        TEMP_DIR.rmdir()

    except OSError:

        pass

    # ========================================================
    # 完了
    # ========================================================

    print()
    print(
        "========================================"
    )

    print(
        "完成しました。"
    )

    print(
        f"出力ファイル: {OUTPUT}"
    )

    print(
        "========================================"
    )

    print()


if __name__ == "__main__":

    main()
